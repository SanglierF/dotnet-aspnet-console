# Common IntelliJ Platform excludes

# User specific
**/.idea/**/workspace.xml
**/.idea/**/tasks.xml
**/.idea/shelf/*
**/.idea/dictionaries
**/.idea/httpRequests/

# Sensitive or high-churn files
**/.idea/**/dataSources/
**/.idea/**/dataSources.ids
**/.idea/**/dataSources.xml
**/.idea/**/dataSources.local.xml
**/.idea/**/sqlDataSources.xml
**/.idea/**/dynamic.xml

# Rider
# Rider auto-generates .iml files, and contentModel.xml
**/.idea/**/*.iml
**/.idea/**/contentModel.xml
**/.idea/**/modules.xml

# Rider copilot
/.idea/.idea.dotnet-aspnet-console/.idea/copilot.data.migration.agent.xml
/.idea/.idea.dotnet-aspnet-console/.idea/copilot.data.migration.ask.xml
/.idea/.idea.dotnet-aspnet-console/.idea/copilot.data.migration.ask2agent.xml
/.idea/.idea.dotnet-aspnet-console/.idea/copilot.data.migration.edit.xml

